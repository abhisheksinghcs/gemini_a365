// Hunting query 1 — this agent's inventory row (latest snapshot).
// Fill TargetAgentId from a365.generated.config.json (field: agenticAppId).
// AgentsInfo stores multiple snapshots per agent; arg_max returns the latest.
let TargetAgentId = "<AGENT_ID>";
AgentsInfo
| where AgentId == TargetAgentId
| summarize arg_max(Timestamp, *) by AgentId
| where LifecycleStatus != "Deleted"
