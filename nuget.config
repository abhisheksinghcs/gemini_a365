<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Org policy: api.nuget.org is blocked; use the Microsoft package feed proxy.
       <clear/> drops any inherited sources (incl. nuget.org) for this repo. -->
  <packageSources>
    <clear />
    <add key="azure-default" value="https://packagefeedproxy.microsoft.io/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
