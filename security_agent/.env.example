# ---------------------------------------------------------------------------
# Model backend (Phase 1). The agent is Gemini-native and env-driven only.
# ---------------------------------------------------------------------------

# Option A — Gemini Developer API (ACTIVE; no GCP project required).
# Get a free key from Google AI Studio (personal Google account is fine).
GOOGLE_API_KEY=

# Pin a concrete model ID (not a *-latest alias) so the same config resolves
# later on regional Vertex AI endpoints.
GEMINI_MODEL=gemini-3.5-flash

# Option B — Vertex AI (customer project; enable later by uncommenting).
# Use GOOGLE_GENAI_USE_ENTERPRISE (ADK 2.x name), NOT GOOGLE_GENAI_USE_VERTEXAI.
# GOOGLE_GENAI_USE_ENTERPRISE=True
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Operator-supplied known trigger (Phase 5). Left blank on purpose.
# The AGENT must NEVER read these — only the attack runner does.
# attacks/private/ is git-ignored.
# ---------------------------------------------------------------------------
A365_KNOWN_TRIGGER_FILE=attacks/private/known_trigger.txt
A365_KNOWN_TRIGGER_PROMPT=
A365_KNOWN_TRIGGER_CLASS=
